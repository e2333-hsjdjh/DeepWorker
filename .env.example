# Copy to .env and fill values locally. Never commit real credentials.
#
# Local DSH protocol host. DeepWorker connects only to 127.0.0.1.
DEEPWORKER_HOST=127.0.0.1
DEEPWORKER_PORT=3080

# Directory used for owned-process bookkeeping (web.pid / web.log).
# Only used by dsh_start / dsh_stop.
DEEPWORKER_STATE_DIR=

# DSH 0.2.2: launch token from the loopback dsh web URL.
DEEPWORKER_DSH_TOKEN=
